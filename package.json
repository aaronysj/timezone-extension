{
  "name": "timezone-extension",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "build": "npm run check:i18n && tsc --noEmit && vite build && node scripts/build-content.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && node e2e/run.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "^0.3.0",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "tzdata": "1.0.51",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "tldts": "^7.4.16"
  }
}
